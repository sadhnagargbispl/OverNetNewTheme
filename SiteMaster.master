<%@ Master Language="C#" AutoEventWireup="true" CodeFile="SiteMaster.master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= (Session["Title"] ?? "My Application") %></title>

    <!-- -------------------- Start CSS Files --------------------  -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet" />

    <script type="text/javascript" src="highslide/highslide-full.js"></script>

    <link rel="stylesheet" type="text/css" href="highslide/highslide.css" />
    <style type="text/css">
        .page {
            margin: 2%;
        }
    </style>

    <script type="text/javascript">
        hs.graphicsDir = 'highslide/graphics/';
        hs.align = 'center';
        hs.transitions = ['expand', 'crossfade'];
        hs.fadeInOut = true;
        hs.dimmingOpacity = 0.8;
        hs.outlineType = 'rounded-white';
        hs.marginTop = 60;
        hs.marginBottom = 40;
        hs.numberPosition = '';
        hs.wrapperClassName = 'custom';
        hs.width = 600;
        hs.height = 500;
        hs.number = 'Page %1 of %2';
        hs.captionOverlay.fade = 0;

        // Add the slideshow providing the controlbar and the thumbstrip

    </script>
    <link rel="stylesheet" href="appstyle.css?=1.5" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>

        <div class="container">
            <div class="row">
                <div class="user">
                    <div class="dwaericon">
                        <!-- role=button + aria-controls improve accessibility -->
                        <button id="drawerToggle" class="drawer-toggle"
                            aria-label="Open drawer"
                            aria-expanded="false"
                            aria-controls="side-drawer"
                            type="button"
                            style="background: transparent; border: none; padding: 8px; display: inline-flex; align-items: center; cursor: pointer; color: #fff;">
                            <svg width="34" height="24" viewBox="0 0 34 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                                <rect x="2" y="3" width="30" height="2" rx="1" fill="currentColor" />
                                <rect x="2" y="11" width="30" height="2" rx="1" fill="currentColor" />
                                <rect x="2" y="19" width="30" height="2" rx="1" fill="currentColor" />
                            </svg>
                        </button>
                    </div>

                    <!-- Drawer overlay and panel -->
                    <div id="drawer-overlay" class="drawer-overlay" hidden aria-hidden="true"></div>

                    <nav id="side-drawer" class="side-drawer" aria-hidden="true" role="navigation" tabindex="-1">
                        <div class="drawer-header" style="margin-top: 25px;">
                            <button id="drawerClose" class="drawer-close" aria-label="Close drawer" type="button">&times;</button>
                            <!-- <div class="drawer-brand"><img src="appimg/logo_white.png" alt="Logo" style="height:36px"></div> -->
                        </div>
                        <% if (Session["Status"] != null && Session["Status"].ToString() == "OK")
                            { %>
                        <ul class="drawer-menu" role="menu" aria-label="Main menu">

                            <li class="has-sub" role="none">
                                <a href="AppDashboard.aspx" role="menuitem" class="menu-link">Dashboard
                                </a>
                            </li>

                            <li class="has-sub" role="none">
                                <a href="#" class="menu-link submenu-toggle" role="menuitem" aria-expanded="false">My Team <span class="arrow">▾</span>
                                </a>
                                <ul class="submenu">
                                    <li><a href="AppMydirects.aspx">Level Wise Report</a></li>
                                    <li><a href="ApprefTree.aspx">My Direct Tree </a></li>
                                    <li><a href="AppTree.aspx">Geneology</a></li>
                                    <li><a href="AppDownline.aspx">Downline Detail</a></li>
                                    <li><a href="AppEverestTree.aspx">My Everest Detail</a></li>
                                    <li><a href="AppBusinessReport.aspx">My Everest Table</a></li>
                                </ul>
                            </li>

                            <li class="has-sub" role="none">
                                <a href="#" class="menu-link submenu-toggle" role="menuitem" aria-expanded="false">Profile <span class="arrow">▾</span>
                                </a>
                                <ul class="submenu">
                                    <li><a href="Appprofile.aspx">Profile</a></li>
                                    <li><a href="AppChangePass.aspx">Change Password</a></li>
                                    <li><a href="AppChangeTransPass.aspx">Change Transaction Password</a></li>
                                </ul>
                            </li>

                            <li class="has-sub" role="none">
                                <a href="#" class="menu-link submenu-toggle" role="menuitem" aria-expanded="false">Upload KYC <span class="arrow">▾</span>
                                </a>
                                <ul class="submenu">
                                    <li><a href="Appiddetail.aspx">Address Proof </a></li>
                                    <li><a href="AppKycbankDetail.aspx">Bank Detail </a></li>
                                    <li><a href="AppPancard.aspx">Pan Card </a></li>
                                </ul>
                            </li>

                            <li class="has-sub" role="none">
                                <a href="#" class="menu-link submenu-toggle" role="menuitem" aria-expanded="false">Epin <span class="arrow">▾</span>
                                </a>
                                <ul class="submenu">
                                    <li><a href="AppPinTransfer.aspx">Pin Transfer</a> </li>
                                    <li><a href="AppPinTransferDetails.aspx">Send Pin Detail</a> </li>
                                    <li><a href="AppPinReceivedDetails.aspx">Received Pin Detail</a> </li>
                                    <li><a href="AppProductrequestDetail.aspx">Shopping</a> </li>
                                    <li><a href="AppPinGenerate.aspx">Pin Generate</a> </li>
                                    <li><a href="AppPingenerateDetail.aspx">Pin Generate Detail</a> </li>
                                </ul>
                            </li>
                            <li class="has-sub" role="none">
                                <a href="#" class="menu-link submenu-toggle" role="menuitem" aria-expanded="false">Income <span class="arrow">▾</span>
                                </a>
                                <ul class="submenu">
                                    <li><a href="AppMonthlyincome.aspx">Monthly Payout Detail</a></li>
                                    <li><a href="Appdailyeverestincome.aspx">Daily Income Detail</a></li>
                                </ul>
                            </li>
                            <li class="has-sub" role="none">
                                <a href="#" class="menu-link submenu-toggle" role="menuitem" aria-expanded="false">Wallet <span class="arrow">▾</span>
                                </a>
                                <ul class="submenu">
                                    <li><a href="AppAllWalletReport.aspx">Wallet Report</a></li>
                                    <li><a href="AppServiceWalletTransfer.aspx">Wallet Transfer</a></li>
                                </ul>
                            </li>
                            <li class="has-sub" role="none">
                                <a href="#" class="menu-link submenu-toggle" role="menuitem" aria-expanded="false">Complaint <span class="arrow">▾</span>
                                </a>
                                <ul class="submenu">
                                    <li><a href="AppComplain.aspx">Raise Ticket</a></li>
                                    <li><a href="AppComplainSolution.aspx">Ticket Status</a></li>
                                </ul>
                            </li>
                            <%--  <li role="none">
                                <a href="Applogout.aspx" role="menuitem">Logout</a>
                            </li>--%>
                        </ul>
                        <% }
                            else
                            { %>
                        <ul class="drawer-menu" role="menu" aria-label="Main menu">
                        </ul>
                        <% }%>
                    </nav>

                    <div class="logo">
                        <img src="appimg/logo_white.png" alt="Site logo" />
                    </div>

                </div>
            </div>
        </div>

        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
    </form>

    <!-- Script: drawer open/close & focus management -->
    <script>
        (function () {
            var toggle = document.getElementById('drawerToggle');
            var closeBtn = document.getElementById('drawerClose');
            var drawer = document.getElementById('side-drawer');
            var overlay = document.getElementById('drawer-overlay');

            // utility: find focusable elements inside the drawer
            function getFocusable(container) {
                return container.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])');
            }

            function openDrawer() {
                drawer.classList.add('open');
                overlay.classList.add('open');
                overlay.hidden = false;
                overlay.setAttribute('aria-hidden', 'false');
                drawer.setAttribute('aria-hidden', 'false');
                toggle.setAttribute('aria-expanded', 'true');

                // move focus into drawer (first focusable)
                var focusables = getFocusable(drawer);
                if (focusables.length) {
                    focusables[0].focus();
                } else {
                    drawer.focus();
                }

                // simple tab wrap to keep keyboard inside drawer
                document.addEventListener('keydown', trapTabKey);
            }

            function closeDrawer() {
                drawer.classList.remove('open');
                overlay.classList.remove('open');
                drawer.setAttribute('aria-hidden', 'true');
                toggle.setAttribute('aria-expanded', 'false');

                // hide overlay after transition for screen readers
                setTimeout(function () {
                    overlay.hidden = true;
                    overlay.setAttribute('aria-hidden', 'true');
                }, 260);

                // remove tab trap and return focus
                document.removeEventListener('keydown', trapTabKey);
                toggle.focus();
            }

            function trapTabKey(e) {
                if (e.key !== 'Tab') return;
                var focusables = Array.prototype.slice.call(getFocusable(drawer));
                if (!focusables.length) return;

                var first = focusables[0], last = focusables[focusables.length - 1];

                if (e.shiftKey) {
                    if (document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    }
                } else {
                    if (document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                }
            }

            // Event handlers
            toggle.addEventListener('click', function () {
                var expanded = this.getAttribute('aria-expanded') === 'true';
                if (expanded) closeDrawer(); else openDrawer();
            });

            closeBtn.addEventListener('click', closeDrawer);
            overlay.addEventListener('click', closeDrawer);

            // close on Escape
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
            });
        })();
    </script>
    <script>
        document.querySelectorAll('.submenu-toggle').forEach(function (toggleBtn) {
            toggleBtn.addEventListener('click', function (e) {
                e.preventDefault();

                let submenu = this.nextElementSibling;
                let arrow = this.querySelector('.arrow');
                let isOpen = submenu.classList.contains('open');

                // Close all other submenus
                document.querySelectorAll('.submenu').forEach(function (s) {
                    s.classList.remove('open');
                });
                document.querySelectorAll('.submenu-toggle .arrow').forEach(function (a) {
                    a.style.transform = 'rotate(0deg)';
                });

                // Toggle selected submenu
                if (!isOpen) {
                    submenu.classList.add('open');
                    arrow.style.transform = 'rotate(180deg)';
                }
            });
        });
    </script>

</body>
</html>
